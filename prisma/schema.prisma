generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

enum SubmissionStatus {
  UNDER_REVIEW
  QUOTE_SENT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
}

enum MeetingChannel {
  WHATSAPP_CALL
  GOOGLE_MEET
}

enum BookingStatus {
  PENDING_SCHEDULE
  CONFIRMED
  COMPLETED
  RESCHEDULED
  CANCELLED
}

enum HandoffStatus {
  PENDING
  WHATSAPP_COORDINATED
  MEET_LINK_SENT
  COMPLETED
}

// 1. User: Clerk-synced via webhook
model User {
  id              String            @id @default(cuid())
  clerkId         String            @unique
  email           String            @unique
  name            String?
  phone           String?
  imageUrl        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  staffPermission StaffPermission?
  submissions     IntakeSubmission[]
  payments        Payment[]

  @@index([clerkId])
  @@index([email])
}

// 2. StaffPermission: Same model as the sister sites (Owner-only & section-level grants)
model StaffPermission {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                  Role     @default(STAFF)
  canManageSubmissions  Boolean  @default(true)
  canManageQuotes       Boolean  @default(true)
  canManageBookings     Boolean  @default(true)
  canManageReports      Boolean  @default(true)
  canManageTeam         Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// 3. Package: Starting packages with inclusions & transparent pricing
model Package {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  subtitle     String?
  priceINR     Int
  priceUSD     Int
  inclusions   String[]  // Array of deliverables/features
  isPopular    Boolean   @default(false)
  isActive     Boolean   @default(true)
  payments     Payment[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// 4. IntakeSubmission: Comprehensive business intake data
model IntakeSubmission {
  id                String            @id @default(cuid())
  userId            String?
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  contactName       String
  contactEmail      String
  contactPhone      String
  businessName      String
  businessType      String            // Retail, Manufacturing, Tech, Services, etc.
  businessStage     String            // Idea, Early Traction, Scaling, Mature, Turnaround
  locationCity      String
  locationCountry   String            @default("India")
  premisesStatus    String?           // Leased, Owned, Searching, Virtual
  floorAreaSqFt     String?
  currentTimeline   String            // Immediate, Next 30 days, Next quarter
  primaryGoals      String            // Text goals
  keyChallenges     String            // Text challenges/bottlenecks
  budgetRange       String?
  preferredChannel  MeetingChannel    @default(WHATSAPP_CALL)
  status            SubmissionStatus  @default(UNDER_REVIEW)

  quotes            Quote[]
  bookings          Booking[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([contactEmail])
  @@index([status])
}

// 5. Quote: Linked to a submission, custom price, sent/accepted status
model Quote {
  id           String            @id @default(cuid())
  submissionId String
  submission   IntakeSubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  title        String
  scopeSummary String
  amount       Int               // Custom price
  currency     String            @default("INR")
  status       QuoteStatus       @default(DRAFT)
  validUntil   DateTime?
  pdfUrl       String?
  payments     Payment[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([submissionId])
}

// 6. Payment: Unified Razorpay/Stripe flat one-time payments
model Payment {
  id                String           @id @default(cuid())
  paymentNumber     String           @unique
  userId            String?
  user              User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  packageId         String?
  package           Package?         @relation(fields: [packageId], references: [id], onDelete: SetNull)
  quoteId           String?
  quote             Quote?           @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  provider          PaymentProvider
  amount            Int
  currency          String           @default("INR")
  status            PaymentStatus    @default(PENDING)
  providerOrderId   String?
  providerPaymentId String?
  providerSignature String?
  booking           Booking?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([paymentNumber])
  @@index([status])
}

// 7. Booking: Linked to submission & payment, scheduled time, WhatsApp/Meet handoff status
model Booking {
  id             String            @id @default(cuid())
  paymentId      String?           @unique
  payment        Payment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  submissionId   String?
  submission     IntakeSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  clientName     String
  clientEmail    String
  clientPhone    String
  scheduledAt    DateTime?
  meetingChannel MeetingChannel    @default(WHATSAPP_CALL)
  meetingLink    String?
  handoffStatus  HandoffStatus     @default(PENDING)
  status         BookingStatus     @default(PENDING_SCHEDULE)
  notes          String?
  report         Report?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([clientEmail])
  @@index([status])
}

// 8. Report: Linked to booking, file reference, delivered timestamp
model Report {
  id            String    @id @default(cuid())
  bookingId     String    @unique
  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  title         String
  summary       String?
  fileReference String    // Cloudflare R2 object key
  fileUrl       String    // R2 endpoint / presigned URL
  fileName      String
  fileSize      Int?
  deliveredAt   DateTime  @default(now())
  downloadCount Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// SEO & Thought Leadership Content
model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  category    String
  readTime    String
  authorName  String   @default("Niraj Kumar")
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}
